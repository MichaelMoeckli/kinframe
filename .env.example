# --- Database (Neon/Vercel Postgres) ---
DATABASE_URL=

# --- Image storage ---
BLOB_READ_WRITE_TOKEN=

# --- AI generation (Replicate / FLUX Kontext) — PRIMARY ---
# FLUX Kontext is purpose-built for identity-preserving stylistic edits.
# Get a token at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# Recommended: kontext-max for best quality, kontext-pro for ~50% cheaper.
REPLICATE_MODEL_VERSION=black-forest-labs/flux-kontext-max

# --- AI generation (Gemini "nano-banana") — FALLBACK ---
# Only used when Replicate isn't configured. Tested but has a hard ceiling
# between style commitment and identity preservation for this task.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# --- Fulfillment (Printful) ---
PRINTFUL_API_KEY=
PRINTFUL_VARIANT_ID=

# --- Transactional email (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@example.com

# --- Rate limiting (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Analytics ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=

# --- Ops ---
ADMIN_PASSWORD=
SENTRY_DSN=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
