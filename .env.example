# --- Database (Neon/Vercel Postgres) ---
DATABASE_URL=

# --- Image storage ---
BLOB_READ_WRITE_TOKEN=

# --- AI generation (Replicate) — PRIMARY ---
# Get a token at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# Locked 2026-09-03 after a 6-way bake-off + a quality-tier probe.
# See docs/model-picking.md. Runs at quality="medium", set in
# lib/ai/replicate.ts - that tier is ~1/4 the price and ~1/3 the latency of
# "high" for a modest quality gain (46.7s vs 135s; $0.05 vs $0.211).
#
# PIN THE VERSION HASH. An unpinned "owner/model" slug lets the provider swap
# the model under you with no deploy: the earlier pick (google/nano-banana-pro,
# unpinned) measurably regressed between the 2026-08-01 and 2026-09-03 runs.
#
# Runner-up: bytedance/seedream-5-pro - clean output and $0.09, but its latency
# is bimodal (~60s or ~130s, 12 observations) so it cannot meet the 60s
# maxDuration on /api/generate without a queue.
# Changing this may need a matching input-schema branch in lib/ai/replicate.ts.
REPLICATE_MODEL_VERSION=openai/gpt-image-2:225c978a7f938acc350564c4548ddc2476bfb33364bec6b5422227f55ce56bd3

# --- AI generation (Gemini "nano-banana") — FALLBACK ---
# Only used when Replicate isn't configured. Tested but has a hard ceiling
# between style commitment and identity preservation for this task.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# --- Fulfillment (Printful) ---
# Private API token: Printful dashboard → Stores → [store] → API access.
PRINTFUL_API_KEY=
# Catalog variant id for the 16x20 framed canvas (GET /products/614 on
# Printful's public catalog API lists every color/size id).
PRINTFUL_VARIANT_ID=
# Printful does not sign webhook payloads (no HMAC, no signature header) —
# this is a secret YOU choose and embed as a query param when registering the
# webhook URL (POST /webhooks with url=".../api/printful/webhook?token=...").
# There is no dashboard field for this; webhooks are API-only, see
# https://developers.printful.com/docs/#tag/Webhook-API
PRINTFUL_WEBHOOK_SECRET=

# --- Transactional email (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@example.com

# --- Rate limiting (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Analytics ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=

# --- Ops ---
ADMIN_PASSWORD=
SENTRY_DSN=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
